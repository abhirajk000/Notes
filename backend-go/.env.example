# ── Server ────────────────────────────────────────────────────────
PORT=4000
APP_ENV=development          # set to "production" on VPS

# ── PostgreSQL (same DB used by the Node.js backend) ─────────────
DATABASE_URL=postgresql://user:password@localhost:5432/notes_db?sslmode=disable

# ── JWT ──────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX
JWT_EXPIRY=168h              # 7 days

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Vercel preview URL(s) here too during testing.
# Example: https://notes.abhiraj.xyz
CORS_ORIGINS=https://notes.abhiraj.xyz,http://localhost:3000

# ── Cookie ───────────────────────────────────────────────────────
# Use parent domain so cookies work across notes.* and api.* subdomains
COOKIE_DOMAIN=.abhiraj.xyz

# ── Private instance (single owner) ──────────────────────────────
ALLOWED_USERNAME=Abhiraj
MAX_USERS=1
