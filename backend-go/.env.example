# ── Server ────────────────────────────────────────────────────────
PORT=4000
APP_ENV=development          # set to "production" on VPS

# ── PostgreSQL (same DB used by the Node.js backend) ─────────────
DATABASE_URL=postgresql://user:password@localhost:5432/notes_db

# ── JWT ──────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX
JWT_EXPIRY=168h              # 7 days

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Vercel preview URL(s) here too during testing.
# Example: https://my-notes.vercel.app,https://notes.example.com
CORS_ORIGINS=http://localhost:3000

# ── Cookie ───────────────────────────────────────────────────────
# Set to your VPS domain in production so the cookie is scoped correctly.
# Leave blank in development.
COOKIE_DOMAIN=
