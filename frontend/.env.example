# ── Local development ───────────────────────────────────────────
# Browser talks directly to Go API on localhost:
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Vercel production (set in Vercel dashboard, NOT in .env.local) ──
# Server-side proxy: notes.abhiraj.xyz/api/* → Go VPS
# BACKEND_URL=https://api.abhiraj.xyz
#
# Do NOT set NEXT_PUBLIC_API_URL in production — the client uses same-origin /api.
