# Copy to /etc/secure-notes/env on your VPS (chmod 600)
#   sudo mkdir -p /etc/secure-notes
#   sudo cp deploy/env.example /etc/secure-notes/env
#   sudo nano /etc/secure-notes/env
#   sudo chown notes:notes /etc/secure-notes/env
#   sudo chmod 600 /etc/secure-notes/env

APP_ENV=production
PORT=4000

DATABASE_URL=postgresql://notes_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/notes_db?sslmode=disable

# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_64
JWT_EXPIRY=168h

# Vercel frontend URL (no trailing slash)
CORS_ORIGINS=https://notes.abhiraj.xyz,https://notes-frontend.vercel.app

# Parent domain so cookies work across notes.* and api.*
COOKIE_DOMAIN=.abhiraj.xyz

ALLOWED_USERNAME=Abhiraj
MAX_USERS=1
